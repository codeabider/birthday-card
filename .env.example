# Copy these to `.env` and fill in from your Supabase project.
# Supabase dashboard → your project → Settings → API Keys
# (direct link: https://supabase.com/dashboard/project/<your-ref>/settings/api-keys)
#
# Without these the app still builds and runs, falling back to the copy and
# Namita defaults compiled into src/lib/config/defaults.js.

# Project URL — shown at the top of the API Keys page, and in the Connect dialog.
# Looks like: https://abcdefghijklm.supabase.co
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The browser key. Use the PUBLISHABLE key (starts with sb_publishable_) from the
# "Publishable and secret API keys" tab. The legacy `anon` / `public` JWT is
# still accepted under PUBLIC_SUPABASE_ANON_KEY if that's all your project has.
#
# This key is safe to commit and ship in the browser bundle — access is enforced
# by the row level security policies in supabase/schema.sql, not by hiding it.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Only this account may edit cards in /admin. Leave blank to allow any
# signed-in account (fine for a single-user setup, but not a strict one).
PUBLIC_OWNER_EMAIL=you@example.com
